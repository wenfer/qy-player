{
  "name": "qy-player",
  "version": "1.0.0",
  "description": "专为老版本 Linux (Deepin 20.9 / Debian 10, glibc 2.28) 开发的 MPV 内核桌面播放器，支持 Jellyfin/Emby",
  "main": "./out/main.cjs",
  "author": "QY Player Team",
  "license": "MIT",
  "homepage": "https://github.com/wenfer/qy-player",
  "repository": {
    "type": "git",
    "url": "git@github.com:wenfer/qy-player.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "test:ui": "node scripts/cdp-test.mjs",
    "build": "npm run typecheck && npm run build:main && npm run build:preload && npm run build:renderer && electron-builder",
    "build:main": "vite build --config electron.vite.config.ts --ssr src/main/index.ts",
    "build:preload": "vite build --config electron.vite.config.ts --ssr src/preload/index.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ext .ts,.tsx",
    "dist": "npm run build && electron-builder",
    "dist:all": "npm run build && ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --linux",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "dist:rpm": "npm run build && ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --linux rpm",
    "dist:appimage": "npm run build && ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --linux appimage",
    "dist:pacman": "npm run build && ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --linux pacman",
    "dist:tar": "npm run build && electron-builder --linux tar.gz tar.xz",
    "test": "ELECTRON_RUN_AS_NODE=1 electron -r ./scripts/electron-node-polyfill.cjs node_modules/vitest/vitest.mjs",
    "quality": "node scripts/check-quality.mjs",
    "test:main": "ELECTRON_RUN_AS_NODE=1 electron -r ./scripts/electron-node-polyfill.cjs node_modules/vitest/vitest.mjs run tests/main",
    "test:render": "ELECTRON_RUN_AS_NODE=1 electron -r ./scripts/electron-node-polyfill.cjs node_modules/vitest/vitest.mjs run tests/renderer",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^21.4.4",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.4.5",
    "vite": "^5.4.14",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "postcss": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "zustand": "^4.5.6"
  }
}
